# Plantilla: el entrypoint de nginx:alpine ejecuta envsubst sobre ella y la deja
# en /etc/nginx/conf.d/default.conf. Solo se sustituyen las variables de entorno
# DEFINIDAS (BACKEND_URL, AUTH_URL): $host, $uri, etc. de nginx se quedan tal cual.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Redirecciones relativas (Location: /aquaapp/): detras de un puerto publicado
    # distinto del 80 (p. ej. 8082) una URL absoluta perderia el puerto.
    absolute_redirect off;

    # DNS interno de Docker. Con las URL en variables (set + proxy_pass $var) nginx
    # resuelve el nombre en cada peticion, no al arrancar: si `backend` o `auth`
    # aun no existen, nginx arranca igualmente y responde 502 hasta que aparezcan.
    resolver 127.0.0.11 valid=10s;
    set $backend ${BACKEND_URL};
    set $auth ${AUTH_URL};

    location = / {
        return 302 /aquaapp/;
    }

    location = /aquaapp {
        return 302 /aquaapp/;
    }

    # API de negocio -> backend (sin URI en proxy_pass: se conserva la ruta /api/...)
    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Autenticacion -> auth, quitando el prefijo: /auth/login -> /login
    location /auth/ {
        rewrite ^/auth/(.*)$ /$1 break;
        proxy_pass $auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: estaticos con fallback a index.html
    location /aquaapp/ {
        try_files $uri $uri/ /aquaapp/index.html;
    }
}
