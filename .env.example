# Copia este fichero a .env para cambiar los valores por defecto del compose.

# Red de Docker creada por el compose de tew-profes-lab-spring
AQUAAPP_NETWORK=aquaapp-network

# Puertos publicados en el host
ANGULAR_PORT=8081
REACT_PORT=8082
FLUTTER_PORT=8083

# Destinos del proxy inverso (nombres de servicio dentro de la red compartida)
BACKEND_URL=http://backend:8080
AUTH_URL=http://auth:9000
